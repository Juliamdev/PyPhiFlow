# Copie este arquivo para .env (na raiz do projeto) e preencha com os valores reais
APP_DEBUG=true

# Dentro do Docker, o host do banco é o nome do serviço no docker-compose.yml
DB_HOST=mysql
DB_PORT=3306
DB_NAME=pyphiflow
DB_USER=pyphiflow
DB_PASSWORD=troque-esta-senha

# Senha do usuário root do MySQL do container
DB_ROOT_PASSWORD=troque-esta-senha-root

# Porta no Windows para acessar o MySQL do container (ex.: pelo MySQL Workbench)
DB_EXTERNAL_PORT=3307
